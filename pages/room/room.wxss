.room-screen {
  padding: 29rpx 34rpx 44rpx;
}

.room-header,
.live-badge,
.route-summary,
.active-group-card,
.section-heading,
.ticket-head,
.ticket-detail,
.ticket-detail view,
.ticket-foot,
.rides-empty,
.choice-link,
.room-footnote,
.modal-heading,
.ride-options,
.gate-switch,
.time-field {
  display: flex;
  align-items: center;
}

.room-header,
.section-heading,
.ticket-head,
.ticket-foot,
.modal-heading {
  justify-content: space-between;
}

.live-badge {
  gap: 9rpx;
  padding: 9rpx 15rpx;
  border: 1rpx solid rgba(84, 216, 204, 0.13);
  border-radius: 100rpx;
  background: rgba(84, 216, 204, 0.055);
  color: #759d9f;
  font-size: 20rpx;
}

.live-badge view {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #54d8cc;
  box-shadow: 0 0 12rpx rgba(84, 216, 204, 0.75);
}

.route-summary {
  justify-content: space-between;
  margin-top: 22rpx;
  padding: 23rpx 26rpx;
}

.route-place {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  align-items: flex-start;
}

.route-place-end {
  align-items: flex-end;
  text-align: right;
}

.route-role {
  padding: 5rpx 11rpx;
  border-radius: 100rpx;
  font-size: 17rpx;
  font-weight: 750;
}

.start-role {
  background: rgba(84, 216, 204, 0.11);
  color: #66ddd4;
}

.end-role {
  background: rgba(239, 141, 118, 0.11);
  color: #ef9b87;
}

.route-name {
  margin-top: 9rpx;
  color: #edf3f6;
  font-size: 27rpx;
  font-weight: 750;
  white-space: nowrap;
}

.route-middle {
  display: flex;
  flex: 0 0 120rpx;
  flex-direction: column;
  align-items: center;
  margin: 20rpx 16rpx 0;
}

.route-line {
  display: flex;
  align-items: center;
  width: 100%;
}

.route-line::before,
.route-line view {
  content: "";
  width: 6rpx;
  height: 6rpx;
  flex: 0 0 6rpx;
  border-radius: 50%;
  background: #54d8cc;
}

.route-line view {
  flex: 1;
  height: 1rpx;
  border-radius: 0;
  background: linear-gradient(90deg, #54d8cc, #ef8d76);
}

.route-line text {
  color: #ef8d76;
  font-size: 27rpx;
  line-height: 1;
}

.route-middle-copy {
  margin-top: 5rpx;
  color: #52657a;
  font-size: 16rpx;
}

.active-group-card {
  width: 100%;
  margin: 19rpx 0 0;
  padding: 20rpx 21rpx;
  border: 1rpx solid rgba(84, 216, 204, 0.18);
  border-radius: 24rpx;
  background: linear-gradient(110deg, rgba(84, 216, 204, 0.13), rgba(84, 216, 204, 0.045));
  color: inherit;
  text-align: left;
  line-height: normal;
}

.active-group-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  flex: 0 0 58rpx;
  border-radius: 18rpx;
  background: rgba(84, 216, 204, 0.13);
}

.active-group-icon view {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #54d8cc;
  box-shadow: 0 0 18rpx rgba(84, 216, 204, 0.75);
}

.active-group-copy {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.active-group-label,
.active-group-title,
.active-group-meta {
  display: block;
}

.active-group-label {
  color: #5f9e9a;
  font-size: 17rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.active-group-title {
  margin-top: 4rpx;
  color: #eaf6f4;
  font-size: 26rpx;
  font-weight: 750;
}

.active-group-meta {
  margin-top: 5rpx;
  color: #718d90;
  font-size: 19rpx;
}

.active-group-enter {
  color: #70cfc8;
  font-size: 37rpx;
}

.rides-section {
  margin-top: 32rpx;
}

.section-heading {
  padding: 0 5rpx;
}

.section-title {
  display: block;
  margin-top: 7rpx;
  color: #f0f5f8;
  font-size: 34rpx;
  font-weight: 750;
}

.section-count {
  padding: 7rpx 13rpx;
  border-radius: 100rpx;
  background: rgba(255, 255, 255, 0.045);
  color: #687a8f;
  font-size: 19rpx;
}

.ride-scroll {
  width: calc(100% + 34rpx);
  margin-top: 23rpx;
  white-space: nowrap;
}

.ride-row {
  display: flex;
  gap: 17rpx;
  padding-right: 34rpx;
}

.ride-ticket {
  flex: 0 0 324rpx;
  width: 324rpx;
  height: 240rpx;
  margin: 0;
  padding: 19rpx 21rpx 16rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.76);
  border-radius: 22rpx;
  background: linear-gradient(145deg, #f4f7f7, #d9e4e5);
  color: #172a39;
  text-align: left;
  line-height: normal;
  box-shadow: 0 18rpx 38rpx rgba(0, 0, 0, 0.22);
}

.ride-ticket-full {
  opacity: 0.52;
}

.ticket-head {
  color: #687881;
  font-size: 16rpx;
  font-weight: 750;
  letter-spacing: 2rpx;
}

.ticket-head view {
  padding: 4rpx 8rpx;
  border: 1rpx solid #b9c6c9;
  border-radius: 100rpx;
  letter-spacing: 0;
}

.ticket-number {
  display: block;
  margin-top: 14rpx;
  color: #122b3d;
  font-family: Arial, Helvetica, sans-serif;
  font-size: 52rpx;
  font-weight: 850;
  letter-spacing: 6rpx;
}

.ticket-detail {
  gap: 18rpx;
  margin-top: 11rpx;
  color: #50636e;
  font-size: 18rpx;
  font-weight: 650;
}

.ticket-detail view {
  gap: 7rpx;
}

.detail-dot {
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
}

.gate-dot { background: #39b9b0; }
.time-dot { background: #e9846c; }

.ticket-foot {
  margin-top: 13rpx;
  padding-top: 11rpx;
  border-top: 1rpx solid rgba(23, 42, 57, 0.12);
  color: #667882;
  font-size: 17rpx;
}

.ticket-foot text:last-child {
  color: #2fa89f;
  font-size: 24rpx;
}

.rides-empty {
  gap: 20rpx;
  margin-top: 16rpx;
  padding: 23rpx 25rpx;
}

.empty-symbol {
  position: relative;
  width: 62rpx;
  height: 62rpx;
  flex: 0 0 62rpx;
  border-radius: 19rpx;
  background: rgba(84, 216, 204, 0.07);
}

.empty-symbol view:first-child {
  position: absolute;
  top: 28rpx;
  left: 14rpx;
  width: 34rpx;
  height: 2rpx;
  background: #54d8cc;
}

.empty-symbol view:last-child {
  position: absolute;
  top: 22rpx;
  right: 13rpx;
  width: 11rpx;
  height: 11rpx;
  border-top: 2rpx solid #54d8cc;
  border-right: 2rpx solid #54d8cc;
  transform: rotate(45deg);
}

.empty-copy {
  min-width: 0;
}

.empty-title,
.empty-text {
  display: block;
}

.empty-title {
  color: #dfe7ec;
  font-size: 26rpx;
  font-weight: 700;
}

.empty-text {
  margin-top: 6rpx;
  color: #687b90;
  font-size: 20rpx;
  line-height: 1.55;
}

.choice-section {
  margin-top: 28rpx;
}

.choice-heading {
  padding: 0 5rpx;
}

.choice-title {
  display: block;
  margin-top: 7rpx;
  color: #f0f5f8;
  font-size: 34rpx;
  font-weight: 750;
}

.choice-description {
  display: block;
  margin-top: 8rpx;
  color: #65778c;
  font-size: 21rpx;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 16rpx;
}

.choice-card {
  display: flex;
  width: 100%;
  min-width: 0;
  min-height: 232rpx;
  margin: 0;
  padding: 18rpx 19rpx 15rpx;
  flex-direction: column;
  align-items: flex-start;
  border: 1rpx solid rgba(255, 255, 255, 0.085);
  border-radius: 26rpx;
  color: inherit;
  text-align: left;
  line-height: normal;
  box-shadow: 0 14rpx 30rpx rgba(0, 0, 0, 0.16);
}

.called-choice {
  background: linear-gradient(145deg, rgba(239, 141, 118, 0.115), rgba(255, 255, 255, 0.032));
}

.join-choice {
  background: linear-gradient(145deg, rgba(84, 216, 204, 0.11), rgba(255, 255, 255, 0.032));
}

.reserve-choice {
  display: grid;
  grid-column: 1 / -1;
  grid-template-columns: 76rpx minmax(0, 1fr) auto;
  grid-template-rows: auto auto;
  column-gap: 22rpx;
  min-height: 232rpx;
  align-items: center;
  padding: 30rpx 28rpx;
  background: linear-gradient(145deg, rgba(145, 157, 243, 0.12), rgba(255, 255, 255, 0.032));
}

.reserve-choice .choice-icon {
  grid-row: 1 / 3;
  width: 76rpx;
  height: 76rpx;
  border-radius: 23rpx;
}

.reserve-choice .choice-name {
  grid-column: 2;
  margin-top: 0;
  align-self: end;
  font-size: 29rpx;
}

.reserve-choice .choice-copy {
  grid-column: 2;
  min-height: 0;
  margin-top: 8rpx;
  align-self: start;
  font-size: 21rpx;
}

.reserve-choice .choice-link {
  grid-column: 3;
  grid-row: 1 / 3;
  width: auto;
  margin: 0;
  padding: 13rpx 16rpx;
  gap: 12rpx;
  border: 1rpx solid rgba(145, 157, 243, 0.15);
  border-radius: 18rpx;
  background: rgba(145, 157, 243, 0.055);
  align-self: center;
}

.reserve-choice .calendar-choice-icon::before {
  top: 21rpx;
  left: 16rpx;
  width: 41rpx;
  height: 36rpx;
}

.reserve-choice .calendar-top {
  top: 30rpx;
  left: 18rpx;
  width: 41rpx;
}

.reserve-choice .calendar-dot {
  top: 41rpx;
  left: 34rpx;
}

.choice-icon {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
}

.car-choice-icon { background: rgba(239, 141, 118, 0.11); }
.crew-choice-icon { background: rgba(84, 216, 204, 0.1); }
.calendar-choice-icon { background: rgba(145, 157, 243, 0.11); }

.car-base {
  position: absolute;
  left: 13rpx;
  top: 27rpx;
  width: 38rpx;
  height: 20rpx;
  border: 3rpx solid #ef8d76;
  border-radius: 9rpx;
}

.car-roof {
  position: absolute;
  left: 22rpx;
  top: 19rpx;
  width: 21rpx;
  height: 13rpx;
  border-top: 3rpx solid #ef8d76;
  border-left: 3rpx solid #ef8d76;
  border-right: 3rpx solid #ef8d76;
  border-radius: 7rpx 7rpx 0 0;
}

.crew-choice-icon view {
  position: absolute;
  top: 27rpx;
  width: 16rpx;
  height: 23rpx;
  border-radius: 9rpx 9rpx 6rpx 6rpx;
  background: #54d8cc;
}

.crew-choice-icon view::before {
  content: "";
  position: absolute;
  top: -10rpx;
  left: 3rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #54d8cc;
}

.crew-choice-icon view:nth-child(1) { left: 24rpx; z-index: 2; }
.crew-choice-icon view:nth-child(2) { left: 10rpx; opacity: 0.5; }
.crew-choice-icon view:nth-child(3) { right: 10rpx; opacity: 0.5; }

.calendar-choice-icon::before {
  content: "";
  position: absolute;
  top: 17rpx;
  left: 13rpx;
  width: 35rpx;
  height: 31rpx;
  border: 3rpx solid #aab4f5;
  border-radius: 7rpx;
}

.calendar-top {
  position: absolute;
  z-index: 1;
  top: 25rpx;
  left: 15rpx;
  width: 35rpx;
  height: 3rpx;
  background: #aab4f5;
}

.calendar-dot {
  position: absolute;
  z-index: 2;
  top: 34rpx;
  left: 28rpx;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #aab4f5;
}

.choice-name {
  margin-top: 15rpx;
  color: #eff4f7;
  font-size: 26rpx;
  font-weight: 750;
}

.choice-copy {
  min-height: 57rpx;
  margin-top: 7rpx;
  color: #6d8094;
  font-size: 19rpx;
  line-height: 1.55;
}

.choice-link {
  justify-content: space-between;
  width: 100%;
  margin-top: auto;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.07);
  color: #9ba9b6;
  font-size: 18rpx;
}

.choice-link text:last-child {
  font-size: 29rpx;
}

.room-footnote {
  justify-content: center;
  gap: 10rpx;
  margin-top: 18rpx;
  color: #4e6176;
  font-size: 18rpx;
}

.room-footnote view {
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: #405369;
}

.plate-modal {
  width: 100%;
  padding: 21rpx 38rpx calc(29rpx + env(safe-area-inset-bottom));
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  border-radius: 36rpx 36rpx 0 0;
  background: #111e31;
  box-shadow: 0 -25rpx 80rpx rgba(0, 0, 0, 0.35);
}

.modal-heading {
  align-items: flex-end;
}

.modal-kicker {
  display: block;
  color: #5ecfc5;
  font-size: 19rpx;
  font-weight: 750;
  letter-spacing: 3rpx;
}

.modal-title {
  display: block;
  margin-top: 7rpx;
  color: #f3f7f9;
  font-size: 38rpx;
  font-weight: 800;
}

.modal-route-mini {
  padding: 8rpx 12rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.04);
  color: #8494a6;
  font-size: 18rpx;
}

.modal-route-mini text {
  margin: 0 5rpx;
  color: #5ecfc5;
}

.modal-description {
  display: block;
  margin-top: 10rpx;
  color: #6b7d91;
  font-size: 21rpx;
}

.plate-field {
  display: flex;
  align-items: center;
  margin-top: 25rpx;
  padding: 13rpx 19rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 21rpx;
  background: linear-gradient(145deg, #f4f7f6, #dae4e5);
}

.plate-prefix {
  padding: 7rpx 10rpx;
  border: 1rpx solid #b0bdc0;
  border-radius: 7rpx;
  color: #596972;
  font-size: 18rpx;
  font-weight: 800;
}

.plate-input {
  flex: 1;
  height: 70rpx;
  margin-left: 15rpx;
  color: #122b3d;
  font-family: Arial, Helvetica, sans-serif;
  font-size: 49rpx;
  font-weight: 850;
  letter-spacing: 7rpx;
  text-align: center;
}

.plate-placeholder { color: #a3b0b5; }

.ride-options {
  align-items: flex-start;
  gap: 13rpx;
  margin-top: 22rpx;
}

.option-column {
  flex: 0.8;
  min-width: 0;
}

.option-column-wide { flex: 1.2; }

.option-label {
  display: block;
  margin-bottom: 9rpx;
  color: #78899d;
  font-size: 19rpx;
}

.gate-switch {
  gap: 8rpx;
}

.gate-option {
  flex: 1;
  height: 62rpx;
  margin: 0;
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  border-radius: 15rpx;
  background: rgba(255, 255, 255, 0.035);
  color: #77899c;
  font-size: 21rpx;
  line-height: 62rpx;
}

.gate-active {
  border-color: rgba(84, 216, 204, 0.32);
  background: rgba(84, 216, 204, 0.11);
  color: #6ddbd3;
  font-weight: 750;
}

.time-field {
  justify-content: space-between;
  height: 62rpx;
  padding: 0 15rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  border-radius: 15rpx;
  background: rgba(255, 255, 255, 0.035);
  color: #e6edf1;
  font-family: Arial, Helvetica, sans-serif;
  font-size: 25rpx;
  font-weight: 750;
}

.time-field text:last-child {
  color: #607388;
  font-size: 31rpx;
}

.modal-submit {
  margin-top: 25rpx;
}
